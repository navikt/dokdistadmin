<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

	<root level="WARN">
		<appender-ref ref="CONSOLE"/>
	</root>
	<logger name="no.nav.dokdistadmin" level="INFO" additivity="false">
		<appender-ref ref="CONSOLE"/>
	</logger>
	<!-- Fjernet warnings om å droppe constraints i embedded testdatabasen -->
	<logger name="org.hibernate.tool.schema.internal" level="ERROR" additivity="false">
		<appender-ref ref="CONSOLE"/>
	</logger>

</configuration>